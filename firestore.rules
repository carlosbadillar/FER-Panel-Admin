rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
}

    function anuncioValido() {
      let d = request.resource.data;
      return d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 120
          && d.resumen is string && d.resumen.size() <= 300
          && d.descripcion is string && d.descripcion.size() <= 10000
          && d.tags is list && d.tags.size() <= 10
          && d.isFeatured is bool
          && d.fecha is timestamp
          && d.publicarEn is timestamp
          && d.autor is string
          && (d.autorFotoUrl == null || d.autorFotoUrl is string)
          && (d.imagenPrincipal == null || d.imagenPrincipal is string)
          && d.imagenesSecundarias is list && d.imagenesSecundarias.size() <= 10
          && d.likes is int && d.likes >= 0
          && d.audiencias is list && d.audiencias.size() > 0
          && d.audiencias.hasOnly(['becarios', 'aspirantes'])
          && d.prioridad in ['normal', 'urgente']
          && d.estado in ['borrador', 'publicado', 'archivado'];
    }

    function soloLike() {
      let antes = resource.data;
      let despues = request.resource.data;
      return despues.diff(antes).affectedKeys().hasOnly(['likes'])
          && antes.estado == 'publicado'
          && despues.likes >= 0
          && (despues.likes - antes.likes == 1 || despues.likes - antes.likes == -1);
    }

    match /anuncios/{id} {
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.estado == 'publicado');
      allow create: if isAdmin() && anuncioValido() && request.resource.data.likes == 0;
      allow update: if (isAdmin() && anuncioValido()
                        && request.resource.data.likes == resource.data.likes)
                    || (request.auth != null && soloLike());
      allow delete: if isAdmin();
    }
  }
}